# Firebase web app config for optional cloud sync (copy to .env.local for local dev).
# Values come from Firebase console > Project settings > General > Your apps > Web app.
# The web config is not secret. If any required value is missing, HappyFit runs local-only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=happyfit-b264a.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=happyfit-b264a
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
